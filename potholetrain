from ultralytics import YOLO
model = YOLO("yolo26n.pt")
model.train(
    data=r"path/to/your/dataset.yaml",  # Update this path to your dataset YAML file
    epochs=30,
    imgsz=640,
    batch=16,              # You can use higher batch size on GPU
    patience=10,
    device=0,              # 0 means first GPU (CUDA)
    name="pothole_yolo26_v2",
    save=True,
    plots=True
)